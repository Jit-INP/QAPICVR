// This shader is responsible for rendering the points generated by the compute shader.
// It is compatible with Unity's Universal Render Pipeline (URP);
// Each point is rendered as a screen-facing quad (billboard) for better visibility.
// Supports XR stereo rendering for VR headsets like Meta Quest 3.
Shader "Unlit/PointCloudURP"
{
    Properties
    {
        // Properties to control the size of the points based on depth.
        _AngularSize("Angular size in degrees", Float) = 0.5
    }
    SubShader
    {
        // Tags indicating this shader is for URP and is opaque.
        Tags { "RenderType"="Opaque" "RenderPipeline"="UniversalPipeline" }

        Pass
        {
            // Standard rendering states for opaque objects.
            ZWrite On
            Cull Off

            HLSLPROGRAM
            // Define the vertex, geometry, and fragment shader functions.
            #pragma vertex Vert
            #pragma geometry Geom
            #pragma fragment Frag
            #pragma target 4.5

            // Enable XR/VR stereo rendering support
            #pragma multi_compile_instancing
            #pragma multi_compile _ STEREO_INSTANCING_ON STEREO_MULTIVIEW_ON

            // Include the URP core library for necessary functions and variables.
            #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"

            // --- Input Buffers (read from) ---
            // These are populated by the C# script with data from the compute shader.
            StructuredBuffer<float4> positions;
            StructuredBuffer<float4> colors;
            StructuredBuffer<float> depths;

            // The point size properties.
            float _AngularSize;
            int _InvertDepth;

            // Input to the vertex shader. The vertex ID is used to index into the buffers.
            struct Attributes
            {
                uint vertexID : SV_VertexID;
                UNITY_VERTEX_INPUT_INSTANCE_ID
            };

            // Output from the vertex shader, and input to the geometry shader.
            struct v2g
            {
                float4 positionWS : TEXCOORD0; // World space position
                float4 color      : COLOR;     // Vertex color
                float depth       : TEXCOORD1; // Depth value (0-1)
                UNITY_VERTEX_INPUT_INSTANCE_ID
            };

            // Output from the geometry shader, and input to the fragment shader.
            struct g2f
            {
                float4 positionHCS : SV_POSITION; // Clip space position
                float4 color       : COLOR;       // Vertex color
                float2 uv          : TEXCOORD0;   // UV for circular points
                UNITY_VERTEX_OUTPUT_STEREO
            };

            // The Vertex Shader
            v2g Vert(Attributes IN)
            {
                v2g OUT;
                UNITY_SETUP_INSTANCE_ID(IN);
                UNITY_TRANSFER_INSTANCE_ID(IN, OUT);
                
                // Fetch the object-space position, color, and depth from the buffers using the vertex ID.
                float4 posOS = positions[IN.vertexID];
                float4 color = colors[IN.vertexID];
                float depth = depths[IN.vertexID];
                
                // Transform the position from object space to world space.
                OUT.positionWS = mul(unity_ObjectToWorld, posOS);
                OUT.color = color;
                OUT.depth = depth;
                return OUT;
            }

            // The Geometry Shader - expands each point into a quad
            [maxvertexcount(4)]
            void Geom(point v2g input[1], inout TriangleStream<g2f> triStream)
            {
                g2f output;
                UNITY_SETUP_INSTANCE_ID(input[0]);
                UNITY_INITIALIZE_VERTEX_OUTPUT_STEREO(output);
                
                output.color = input[0].color;

                // Get camera right and up vectors in world space
                float3 cameraUp = UNITY_MATRIX_V[1].xyz;
                float3 cameraRight = UNITY_MATRIX_V[0].xyz;

                // Calculate point size based on depth
                // Apply inversion if needed (depth is already inverted in compute shader if flag is set)
                // Near points (small depth after inversion) = max size
                // Far points (large depth after inversion) = min size
                float depthForSize = input[0].depth;
                if (_InvertDepth == 1)
                {
                    depthForSize = 1.0 - depthForSize;
                }
                //float pointSize = lerp(_MaxPointSize, _MinPointSize, depthForSize);
                //float halfSize = pointSize * 0.5;
                // Let's just make the size dependent on the distance so the angular size is constant
                float distance = length(input[0].positionWS.xyz);
                float pointSize = distance * tan((_AngularSize / (2 * 3.141592)) * 0.5);

                // Create 4 corners of the quad
                float3 positions[4];
                positions[0] = input[0].positionWS.xyz - cameraRight * pointSize - cameraUp * pointSize; // Bottom-left
                positions[1] = input[0].positionWS.xyz + cameraRight * pointSize - cameraUp * pointSize; // Bottom-right
                positions[2] = input[0].positionWS.xyz - cameraRight * pointSize + cameraUp * pointSize; // Top-left
                positions[3] = input[0].positionWS.xyz + cameraRight * pointSize + cameraUp * pointSize; // Top-right

                float2 uvs[4];
                uvs[0] = float2(0, 0);
                uvs[1] = float2(1, 0);
                uvs[2] = float2(0, 1);
                uvs[3] = float2(1, 1);

                // Emit the 4 vertices as a triangle strip
                for (int i = 0; i < 4; i++)
                {
                    output.positionHCS = mul(UNITY_MATRIX_VP, float4(positions[i], 1.0));
                    output.uv = uvs[i];
                    triStream.Append(output);
                }
            }

            // The Fragment Shader
            half4 Frag(g2f IN) : SV_Target
            {
                UNITY_SETUP_STEREO_EYE_INDEX_POST_VERTEX(IN);
                
                // Make the points circular by discarding fragments outside a circle
                float2 centered = IN.uv * 2.0 - 1.0;
                float dist = length(centered);
                if (dist > 1.0)
                    discard;

                // Return the color fully opaque
                return IN.color;
            }
            ENDHLSL
        }
    }
}